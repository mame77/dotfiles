
theme = "Tokyo Night"

font-family = "Isevka Nord Font"
font-size = 14
font-feature = -dlig

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

background-opacity = 0.8
gtk-titlebar = true
confirm-close-surface = false
app-notifications = no-config-reload, no-clipboard-copy

window-theme = ghostty
window-decoration = none
window-padding-x = 6
window-padding-y = 6

