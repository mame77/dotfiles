
theme = "Tokyo Night"
# font
font-family = "Isevka Nord Font"
font-size = 17
font-feature = -dlig
# cursor
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor
# display
window-theme = ghostty
background-opacity = 1
window-decoration = none
window-padding-x = 6
window-padding-y = 6
# other
gtk-titlebar = true
confirm-close-surface = false

