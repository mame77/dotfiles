// setting
input {
    keyboard {
        numlock
        repeat-delay 300
        repeat-rate 30
    }
    touchpad {
        tap
        natural-scroll
        scroll-factor 0.3
    }
}
gestures {
    hot-corners {
        off
    }
}
cursor {
    hide-when-typing
}
output "eDP-1" {
    mode "1920x1080@60"
    scale 1.25
    position x=0 y=0
}
output "HDMI-A-1" {
    mode "1920x1080@60"
    position x=1536 y=0
}
layout {
    focus-ring { width 4; active-color "#B0E0E6"; inactive-color "#505050"; }
    struts { top 0; bottom 6; left 6; right 6; }
}
window-rule {
    match app-id="TUI.float|net.lutris.Lutris|steam|LocalSend"
    open-floating true
    open-maximized false
}
window-rule {
    match app-id="TUI.float"
    opacity 0.95
}
// startup
prefer-no-csd
spawn-at-startup "fcitx5"
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "pipewire"
spawn-at-startup "swaybg" "-i" "/home/mame/Downloads/blue-sky.jpg" "-m" "stretch"
spawn-at-startup "sh" "-c" "/home/mame/.config/niri/scripts/battery-monitor.sh"
hotkey-overlay {
    skip-at-startup
}
environment {
    DISPLAY ":0"
    XDG_SESSION_TYPE "wayland"
    QT_QPA_PLATFORM "wayland"
    GDK_BACKEND "wayland"
    MOZ_ENABLE_WAYLAND "1"
    GTK_THEME "Adwaita"
    QT_STYLE_OVERRIDE "Adwaita"
}

screenshot-path "~/design/image/Screenshot from %m-%d %H-%M.png"
// display
window-rule {
    open-maximized true
    draw-border-with-background false
}
workspace "one"
workspace "two"
workspace "three"
binds {
    // app
    Mod+F      { spawn "fuzzel"; }
    Mod+W      { spawn "chromium"; }
    Mod+Return { spawn-sh "ghostty --class='app' --command='tmux'"; }
    Mod+G     { spawn-sh "chromium --new-window --app='https://grok.com/'"; }
    Mod+S     { spawn-sh "chromium --new-window --app='https://app.slack.com/client/'"; }
    Mod+D     { spawn-sh "chromium --new-window --app='https://discord.com/app'"; }
    // system
    Mod+1     { spawn-sh "ghostty --class='TUI.float' --command='bluetuith'"; }
    Mod+2     { spawn-sh "ghostty --class='TUI.float' --command='wiremix'"; }
    Mod+3     { spawn-sh "ghostty --class='TUI.float' --command='impala'"; }
    Mod+4     { spawn-sh "ghostty --class='app' --command='btop'"; }
    // move
    Mod+H     { focus-column-or-monitor-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-or-monitor-right; }
    // move column
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+J     { move-column-to-workspace-down; }
    Mod+Ctrl+K     { move-column-to-workspace-up; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    // sound
    Mod+I { spawn "sh" "-c" "/home/mame/.config/niri/scripts/volume.sh 5%+"; }
    Mod+U { spawn "sh" "-c" "/home/mame/.config/niri/scripts/volume.sh 5%-"; }
    Mod+Shift+U { spawn "sh" "-c" "/home/mame/.config/niri/scripts/mute.sh"; }
    // blight
    Mod+Comma { spawn "sh" "-c" "/home/mame/.config/niri/scripts/brightness.sh 10%+"; }
    Mod+M     { spawn "sh" "-c" "/home/mame/.config/niri/scripts/brightness.sh 10%-"; }
    // lock
    Mod+R { spawn "swaylock"; }
    // record
    Mod+Z { spawn "sh" "-c" "bash /home/mame/.config/niri/mod/screen-record.sh";}
    Mod+Shift+P { screenshot-window; }
    Mod+P  { screenshot; }
    // column size
    Mod+O { maximize-column; }
    Mod+Shift+O { fullscreen-window; }
    // off
    Mod+Q  { close-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+Q { power-off-monitors; }
}
